@model HulubejeBooking.Models.HistoryWrapper
@using HulubejeBooking.Models.BusModels;
<partial name="_Navigation" />
<head>
    <title>History</title>
    <style>
        .btn:focus {
            outline: none;
            box-shadow: none;
        }

        .wide-tab {
            max-width: 300px;
        }

        .customcard {
            height: 180px;
            color: inherit;
        }

            .customcard:hover {
                cursor: pointer;
                color: inherit; 
                text-decoration: none;
            }

        .companyimage {
            object-fit: contain;
            max-height: 150px;
            width: 100%;
        }

        .card {
            transition: box-shadow 0.3s;
        }

            .card:hover {
                box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
            }

        @@media (max-width: 992px) {
            .companyimage {
                object-fit: contain;
                max-height: 100px; /* Set the maximum height as needed */
            }
        }

        @@media (max-width: 300px) {
            .companyimage {
                object-fit: contain;
                max-height: 80px; /* Set the maximum height as needed */
            }

            .customcard {
                height: 165px;
            }
        }

        #myTabs {
            flex-wrap: nowrap;
        }

        .nav-link.active {
            font-weight: bold;
        }

    </style>
</head>
<div class="container vh-50 mt-3 mb-3">
    <ul class="nav nav-tabs" id="myTabs">
        <li class="nav-item">
            <a class="nav-link active wide-tab" id="tab1-tab" data-toggle="tab" href="#tab1">Orders</a>
        </li>
        <li class="nav-item">
            <a class="nav-link wide-tab" id="tab2-tab" data-toggle="tab" href="#tab2">Trips </a>
        </li>
        <li class="nav-item">
            <a class="nav-link wide-tab" id="tab3-tab" data-toggle="tab" href="#tab3">Payment</a>
        </li>
    </ul>
    <div class="tab-content mt-4 ">

        <div class="tab-pane fade show active" id="tab1">
            @if (Model?.OrdersModel?.Data?.Count() > 0)
            {
                <div id="orders-history">
                    @await Html.PartialAsync("_VoucherHistoryPartial", Model?.OrdersModel?.Data, new ViewDataDictionary(ViewData) {
                { "IsOrderHistory", true }
                })
                </div>
                <div id="orders-loading-indicator" class="text-center my-3 loading-indicator" style="display:none;">
                    <div class="spinner-border text-primary"></div>
                </div>
                <div class="text-center my-3">
                    <button id="load-more-orders" class="btn btn-primary">Load More</button>
                </div>
            }
            else
            {
                @await Html.PartialAsync("_ErrorMessage", null, new ViewDataDictionary(ViewData) {
                { "Message", "No order history found." }
                })
            }
        </div>
        <partial name="_ReviewModal" />

        <div class="tab-pane fade" id="tab2">
            @if (Model?.HistoryModel?.Count() > 0)
            {
                @foreach (var route in Model?.HistoryModel?.Take(10) ?? Enumerable.Empty<HistoryModel>())
                {
                    if (route != null)
                    {
                        <div class="card mt-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-4 mb-2">
                                        <img src="@(route?.ImgUrl ?? "../Assets/bus.png")" class="img-fluid companyimage" alt="Supplier Logo" />
                                    </div>
                                    <div class="col-sm-4 ">
                                        <h5 class="card-title">@route?.RouteName</h5>
                                        <p class="card-text">Route Description: @route?.RouteDescription</p>
                                        <p class="card-text">Departure Date: @route?.DepartureDate.ToString("yyyy-MM-dd HH:mm:ss")</p>
                                        <p class="card-text">Distance: @route?.Distance km</p>

                                            <div class="ticket-details">
                                                <table class="table table-bordered mt-3">
                                                    <thead>
                                                        <tr>
                                                            <th>Passenger</th>
                                                            <th>Subtotal</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                            <tr>
                                                                <td>
                                                                    @route?.PassengerFullName 
                                                                </td>
                                                                <td>@route?.SubTotal</td>
                                                            </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @await Html.PartialAsync("_ErrorMessage", null, new ViewDataDictionary(ViewData) {
                        { "Message", "No trip history found." }
                        })
                    }
                }
            }
            else
            {
                @await Html.PartialAsync("_ErrorMessage", null, new ViewDataDictionary(ViewData) {
                    { "Message", "No trip history found." }
                    })
            }
        </div>
        <div class="tab-pane fade" id="tab3">
            @if (Model?.PayementsHistory?.Data?.Count() > 0)
            {
                <div id="payment-history">
                    @await Html.PartialAsync("_VoucherHistoryPartial", Model?.PayementsHistory?.Data, new ViewDataDictionary(ViewData) {
                { "IsOrderHistory", false }
                })
                </div>

                <div id="loading-indicator" class="text-center my-3" style="display:none;">
                    <div class="spinner-border text-primary"></div>
                </div>

                <div class="text-center my-3">
                    <button id="load-more-payments" class="btn btn-primary">Load More</button>
                </div>
            }
            else
            {
                @await Html.PartialAsync("_ErrorMessage", null, new ViewDataDictionary(ViewData) {
                    { "Message", "No payment history found." }
                    })
                
            }
            
        </div>
    </div>
</div>
<script>
    window.phoneNumber = '@ViewBag.PhoneNumber';
</script>
@section Scripts {
    <script src="~/js/history/history.js" asp-append-version="true"></script>
    <script src="~/js/history/review-modal.js" asp-append-version="true"></script>
}
<partial name="_Footer" />

