@model List<string>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hulubeje Booking</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        /* === Base Styles === */
        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f4f6f9;
            color: #333;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            transition: all 0.3s;
        }

            a:hover {
                text-decoration: none;
                color: #0d6efd;
            }

        h5 {
            font-weight: 600;
        }

        /* === Carousel Styles === */
        .carousel-item {
            position: relative;
            width: 100%;
            aspect-ratio: 16/9; /* keeps 16:9 ratio */
            max-height: 550px;
            overflow: hidden;
            border-radius: 12px;
        }

            .carousel-item img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }

        @@media (min-width: 768px) {
            .carousel-item img:hover {
                transform: scale(1.05); /* subtle zoom on hover */
            }
        }

        .carousel-indicators [data-bs-target] {
            background-color: #0d6efd;
        }

        /* === Service Cards === */
        .service-card {
            border: none;
            border-radius: 15px;
            padding: 25px 20px;
            background: #fff;
            box-shadow: 0 6px 18px rgba(0,0,0,0.08);
            transition: transform 0.3s, box-shadow 0.3s;
            text-align: center;
        }

            .service-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 12px 25px rgba(0,0,0,0.15);
            }

            .service-card i {
                font-size: 3rem;
                color: #0d6efd;
                margin-bottom: 15px;
            }

        /* === Responsive adjustments === */
        @@media (max-width: 576px) {
            .service-card {
                padding: 20px 10px;
            }

                .service-card i {
                    font-size: 2.5rem;
                }
        }

        /* === Footer spacing === */
        footer {
            margin-top: 50px;
        }
    </style>
</head>

<body>
    <!-- Navigation -->
    <partial name="_Navigation" />

    <main class="container my-4">
        <!-- === Hero Carousel === -->
        <div id="heroCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
            <div class="carousel-inner" id="heroCarouselInner"></div>

            <!-- Carousel Controls -->
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>

        <!-- === Services Section === -->
        <section class="row g-4">
            <!-- Hotels -->
            <div class="col-md-4 col-sm-6">
                <a asp-controller="hotel" asp-action="Index" class="text-dark">
                    <div class="service-card">
                        <i class="bi bi-building"></i>
                        <h5>Hotels</h5>
                        <p>Book the best stays with Hulubeje.</p>
                    </div>
                </a>
            </div>

            <!-- Cinema -->
            <div class="col-md-4 col-sm-6">
                <a asp-controller="cinema" asp-action="Index" class="text-dark">
                    <div class="service-card">
                        <i class="bi bi-film"></i>
                        <h5>Cinema</h5>
                        <p>Reserve seats and enjoy the latest movies.</p>
                    </div>
                </a>
            </div>

            <!-- Bus -->
            <div class="col-md-4 col-sm-6">
                <a asp-controller="bus" asp-action="Index" class="text-dark">
                    <div class="service-card">
                        <i class="bi bi-bus-front"></i>
                        <h5>Bus</h5>
                        <p>Find and book bus tickets with ease.</p>
                    </div>
                </a>
            </div>

            <!-- Spa -->
            <div class="col-md-4 col-sm-6">
                <a asp-controller="spa" asp-action="Index" class="text-dark">
                    <div class="service-card">
                        <i class="bi bi-person-lines-fill"></i> <!-- updated icon more spa-like -->
                        <h5>Spa</h5>
                        <p>Relax and refresh with top spa bookings.</p>
                    </div>
                </a>
            </div>

            <!-- Events -->
            <div class="col-md-4 col-sm-6">
                <a asp-controller="event" asp-action="Index" class="text-dark">
                    <div class="service-card">
                        <i class="bi bi-calendar-event"></i>
                        <h5>Events</h5>
                        <p>Never miss concerts, shows, and gatherings.</p>
                    </div>
                </a>
            </div>

            <!-- Stadiums -->
            <div class="col-md-4 col-sm-6">
                <a asp-controller="stadium" asp-action="Index" class="text-dark">
                    <div class="service-card">
                        <i class="bi bi-trophy"></i>
                        <h5>Stadiums</h5>
                        <p>Book stadium tickets for sports & more.</p>
                    </div>
                </a>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <partial name="_Footer" />

    <!-- === Carousel Script === -->
    <script>
        // Convert Razor List<string> into JS array
        let heroImages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        // Keep only valid image URLs
        const validExtensions = ['.png', '.jpg', '.jpeg', '.webp', '.gif'];
        heroImages = heroImages.filter(url => validExtensions.some(ext => url.toLowerCase().endsWith(ext)));

        const carouselInner = document.getElementById('heroCarouselInner');

        if (!heroImages || heroImages.length === 0) {
            // Fallback image if no images exist
            const fallbackDiv = document.createElement('div');
            fallbackDiv.className = "carousel-item active";
            fallbackDiv.innerHTML = `
                <img src="https://ftp-hulubeje.cnetcommerce.com/AppIndustrySectors/Banner/1/Customer support.png"
                     class="d-block w-100" alt="Fallback Image">
            `;
            carouselInner.appendChild(fallbackDiv);
        } else {
            heroImages.forEach((src, idx) => {
                const div = document.createElement('div');
                div.className = `carousel-item ${idx === 0 ? 'active' : ''}`;
                div.innerHTML = `<img src="${src}" class="d-block w-100" alt="Slide ${idx + 1}">`;
                carouselInner.appendChild(div);
            });
        }
    </script>
</body>
</html>