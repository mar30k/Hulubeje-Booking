<partial name="_Navigation" />
<title>Stadium</title>
<partial name="_ComingSoon" />
@section Scripts {
    <script>
        const images = ["url('https://seatlab.com/wp-content/uploads/Sports-Ticket-Management-Software.jpg')",
            "url('https://seatlab.com/wp-content/uploads/Stadium-Ticketing-System.jpg')"];
        const intervalInMinutes = 0.1;
        let currentIndex = 0;
        const messageContainer = document.getElementById('message-container');

        function changeBackgroundImage() {
            messageContainer.style.backgroundImage = images[currentIndex];
            currentIndex = (currentIndex + 1) % images.length;
        }

        changeBackgroundImage();

        setInterval(changeBackgroundImage, intervalInMinutes * 60 * 1000);
    </script>
}


